# Azure AI Foundry. Deployment names must match the pool entries exactly
# (configs/pools.yaml) or calls 404 with a "model not found" that looks like
# the model is missing.
AZURE_ENDPOINT=https://<resource>.services.ai.azure.com/models
AZURE_API_KEY=<key>

# Optional, legacy. The OpenRouter pool is spent and its key needs rotating.
OPENROUTER_API_KEY=
