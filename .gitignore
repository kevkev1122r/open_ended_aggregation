# secrets
.env
*.key
*.pem

# environments / caches
venv/
node_modules/
__pycache__/
*.pyc
.DS_Store

# Cached model generations ARE tracked: they are the expensive research record
# (~$130 of Azure spend) and every analysis runs off them with zero API calls,
# so the team can reproduce results without regenerating.
# Source datasets stay out -- they are public downloads and large.
data/*.parquet
data/*.zip
share/

# local logs
*.log

# build artifacts
*.egg-info/
build/
dist/

# raw QUEST release — re-downloadable from storage.googleapis.com/gresearch/quest/
data/quest_test.jsonl
data/quest_train.jsonl
data/quest_val.jsonl

# LongWeave raw release (224 MB) — re-downloadable, never commit
data/longweave.jsonl

# mpnet sentence-embedding cache for ASQA — derived, regenerated automatically
# by analysis/asqa_ensembles.py in ~1 min if absent
data/asqa_sent_emb.npy

# ASC edit-distance edge cache (124 MB) — derived, rebuilt by analysis/asc_ensembles.py
data/asc_edges.pkl
