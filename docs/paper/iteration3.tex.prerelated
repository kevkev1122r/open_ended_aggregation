    \texttt{gpt-5.4-nano}          &  8.98 &  1 & 24.3 & 1067 & 14,670 & $0.22\%$ \\
    \midrule
    Pool                           &       &    &      &      & 95,772 & $1.17\%$ \\
    \bottomrule
  \end{tabular}
\end{table}

