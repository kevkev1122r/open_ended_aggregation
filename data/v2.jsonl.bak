{"qid": "med:14", "domain": "medqa", "model": "anthropic/claude-sonnet-5", "resp": "Zinc deficiency\n\nAnswer: Zinc deficiency (due to malabsorption from extensive bowel resection in Crohn disease)", "correct": true, "gold": "Zinc"}
